rules_version = '2';

// Every read and write in this app goes through the Firebase Admin SDK in
// server-side route handlers, and the Admin SDK bypasses these rules entirely.
// Nothing should ever reach Firestore straight from a browser, so deny all
// direct client access. The web API key is public by necessity (it is needed
// for Google sign-in on /admin) — this is what stops that key being used to
// read business profile submissions from outside the app.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
