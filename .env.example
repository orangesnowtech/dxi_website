NEXT_PUBLIC_SANITY_PROJECT_ID=your-actual-projectid-here
NEXT_PUBLIC_SANITY_DATASET=your-actual-dataset-here
SANITY_API_WRITE_TOKEN=your-actual-token-here
ZEPTOMAIL_TOKEN=your-actual-token-here
ZEPTOMAIL_BOUNCE_ADDRESS=noreply@yourdomain.com
CONTACT_FORM_RECIPIENT_EMAIL=contact@yourdomain.com
BUSINESS_PROFILE_RECIPIENT_EMAIL=contact@yourdomain.com
# Where new event registrations are announced. Falls back to CONTACT_FORM_RECIPIENT_EMAIL.
EVENTS_RECIPIENT_EMAIL=events@yourdomain.com
# Event posters. Defaults to <FIREBASE_PROJECT_ID>.firebasestorage.app, falling
# back to the older .appspot.com naming. Set only to override.
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-client-email
FIREBASE_PRIVATE_KEY="your-service-account-private-key"
# ---- Admin dashboard access ----
# The /admin dashboard is gated by Firebase Auth (Google sign-in). These are the
# public web-app keys from Firebase console > Project settings > Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id

# Local admin sign-in, development only. Google sign-in on localhost needs
# http://localhost:3001/__/auth/handler listed as an authorised redirect URI on
# the OAuth client; when it is not, sign-in dies at Google with "Access
# blocked". These let you sign in with a password instead. The form they feed
# is compiled out of production builds, so the deployed dashboard stays
# Google-only. Never set these in apphosting.yaml.
#
#   node scripts/seed-admins.js you@example.com   # create the user, grant admin
#   node scripts/dev-admin-password.js            # write this password into it
#
# Read by that script alone; nothing reads them at runtime.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
# Prefills the email box on the dev form so you only type the password.
NEXT_PUBLIC_DEV_ADMIN_EMAIL=


# ---- DXI assistant (chat bot) ----
# Google AI Studio key. With this unset the widget is not rendered at all and
# /api/bot/chat answers 503 — the bot is inert rather than broken.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Minutes a handed-off conversation waits for a person before the bot resumes.
BOT_HANDOFF_TIMEOUT_MINUTES=15
# Model calls allowed per conversation per hour.
BOT_HOURLY_MESSAGE_LIMIT=40
