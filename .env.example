NEXT_PUBLIC_SANITY_PROJECT_ID=your-actual-projectid-here
NEXT_PUBLIC_SANITY_DATASET=your-actual-dataset-here
SANITY_API_WRITE_TOKEN=your-actual-token-here
ZEPTOMAIL_TOKEN=your-actual-token-here
ZEPTOMAIL_BOUNCE_ADDRESS=noreply@yourdomain.com
CONTACT_FORM_RECIPIENT_EMAIL=contact@yourdomain.com
BUSINESS_PROFILE_RECIPIENT_EMAIL=contact@yourdomain.com
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-client-email
FIREBASE_PRIVATE_KEY="your-service-account-private-key"
# ---- Admin dashboard access ----
# The /admin dashboard is gated by Firebase Auth (Google sign-in). These are the
# public web-app keys from Firebase console > Project settings > Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id

